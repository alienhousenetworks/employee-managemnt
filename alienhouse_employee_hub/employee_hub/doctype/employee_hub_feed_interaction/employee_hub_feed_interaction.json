{
  "doctype": "DocType",
  "name": "Employee Hub Feed Interaction",
  "module": "Employee Hub",
  "autoname": "format:EHI-.YYYY.-.#####",
  "title_field": "author_name",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "feed_post",
      "label": "Feed Post",
      "fieldtype": "Link",
      "options": "Employee Hub Feed Post",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "interaction_type",
      "label": "Interaction Type",
      "fieldtype": "Select",
      "options": "Comment\nReaction",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "content",
      "label": "Comment",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.interaction_type == 'Comment'",
      "reqd": 0
    },
    {
      "fieldname": "reaction",
      "label": "Reaction",
      "fieldtype": "Select",
      "options": "Like\nLove\nCelebrate\nSupport\nInsightful",
      "depends_on": "eval:doc.interaction_type == 'Reaction'"
    },
    {
      "fieldname": "parent_interaction",
      "label": "Reply To",
      "fieldtype": "Link",
      "options": "Employee Hub Feed Interaction"
    },
    {
      "fieldname": "author",
      "label": "Author User",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "author_name",
      "label": "Author",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "mentioned_users",
      "label": "Mentioned Users JSON",
      "fieldtype": "Long Text",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "Employee",
      "read": 1,
      "create": 1
    },
    {
      "role": "HR Manager",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "ASC"
}
